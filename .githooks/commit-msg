#!/usr/bin/env bash
# Enforces atomic conventional-commit messages and clean authorship.
# Enable once with: git config core.hooksPath .githooks
msg_file="$1"

# Merge/revert commits generated by git are exempt from the format rule.
first_line="$(head -n1 "$msg_file")"
case "$first_line" in
  Merge\ *|Revert\ *) exit 0 ;;
esac

# Repo policy: no AI co-author trailers.
if grep -qiE '^co-authored-by:.*(claude|anthropic)' "$msg_file"; then
  echo "commit-msg: remove AI co-author trailers (repo policy)." >&2
  exit 1
fi

# Conventional format: type(scope): subject, subject <= 72 chars.
if ! printf '%s' "$first_line" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9./-]+\))?: .{1,72}$'; then
  echo "commit-msg: use 'type(scope): subject' (subject <= 72 chars)." >&2
  echo "  types: feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi
